# Production (Vercel) — Project Settings → Environment Variables
NODE_ENV=production
SITE_URL=https://atatarifi.com
API_BASE_URL=https://api.atatarifi.com

# Build-time (must be set BEFORE deploy build)
VITE_API_BASE_URL=https://api.atatarifi.com
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
# Optional explicit override; must match a Google Console Authorized redirect URI exactly:
VITE_GOOGLE_LOGIN_URI=https://api.atatarifi.com/auth/google/callback

# --- Google Cloud Console (OAuth 2.0 Web client) ---
# Authorized JavaScript origins:
#   https://atatarifi.com
#   https://www.atatarifi.com
#   http://localhost:5173
#
# Authorized redirect URIs (must match login_uri EXACTLY):
#   https://api.atatarifi.com/auth/google/callback
#   http://localhost:5152/auth/google/callback

# Local development (.env.local or .env)
# SITE_URL=http://localhost:5173
# API_BASE_URL=http://localhost:5152
# VITE_API_BASE_URL=http://localhost:5152
# VITE_GOOGLE_LOGIN_URI=http://localhost:5152/auth/google/callback
